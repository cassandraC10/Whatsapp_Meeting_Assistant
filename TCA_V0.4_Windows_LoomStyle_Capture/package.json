{
  "name": "tca-windows-loomstyle-capture",
  "version": "0.5.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tca.capture",
    "productName": "TCA Capture",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "TCA Capture",
        "schemes": [
          "tca-capture"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/icon-512.png"
    }
  }
}
