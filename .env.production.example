TCA_ENV=production
TCA_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
TCA_FRONTEND_URLS=https://YOUR-SITE.netlify.app
TCA_ALLOWED_HOSTS=YOUR-BACKEND.onrender.com

TCA_CLOUD_ENABLED=true
TCA_CLOUD_REQUIRED=true
DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Admin analytics. Comma-separated for multiple admins.
TCA_ANALYTICS_ADMIN_EMAILS=you@example.com

# Optional Gemini cost estimates. Leave blank for token-only metering.
TCA_GEMINI_INPUT_COST_USD_PER_1M=
TCA_GEMINI_OUTPUT_COST_USD_PER_1M=

# Production capture transport: browser mic + shared system/tab audio -> Render.
TCA_CAPTURE_MODE=browser

# Optional private-beta usage limits. Blank = unlimited.
TCA_BETA_MAX_CONVERSATIONS=
TCA_BETA_MAX_RECORDING_MINUTES=
TCA_BETA_MAX_AI_REQUESTS=
TCA_MAX_BODY_MB=25

# Optional S3/R2 storage for durable raw audio/recording files.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_OBJECT_PREFIX=tca
