# TCA V0.5 local development
TCA_ENV=development
TCA_AUTH_SECRET=
TCA_FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
TCA_ALLOWED_HOSTS=*

# Cloud foundation / private beta
TCA_CLOUD_ENABLED=false
TCA_CLOUD_REQUIRED=false
DATABASE_URL=

# Gemini — server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Private beta analytics admin(s)
TCA_ANALYTICS_ADMIN_EMAILS=
# Backward-compatible singular form:
TCA_ANALYTICS_ADMIN_EMAIL=

# Optional Gemini cost estimate used by analytics
TCA_GEMINI_INPUT_COST_USD_PER_1M=
TCA_GEMINI_OUTPUT_COST_USD_PER_1M=

# Current local Windows/Electron recorder mode
TCA_CAPTURE_MODE=local_server

# Optional private-beta limits; blank = unlimited
TCA_BETA_MAX_CONVERSATIONS=
TCA_BETA_MAX_RECORDING_MINUTES=
TCA_BETA_MAX_AI_REQUESTS=
TCA_MAX_BODY_MB=25

# S3-compatible storage (AWS S3 / Cloudflare R2)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_OBJECT_PREFIX=tca
