# TCA V0.5 Cloud Foundation
# Keep disabled for local-only development.
TCA_CLOUD_ENABLED=false
TCA_CLOUD_REQUIRED=false

# Render PostgreSQL / managed PostgreSQL
DATABASE_URL=

# S3-compatible object storage (AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_OBJECT_PREFIX=tca

# Existing TCA auth secret
TCA_AUTH_SECRET=

# Feature 9 — Analytics
# Set this to the beta/admin account email to enable /analytics/admin.
TCA_ANALYTICS_ADMIN_EMAIL=

# Optional Gemini standard-rate estimate used by TCA analytics.
# Leave blank if you only want token/request counts.
TCA_GEMINI_INPUT_COST_USD_PER_1M=
TCA_GEMINI_OUTPUT_COST_USD_PER_1M=
